# Base URL of the Django REST API (see backend/README.md)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Public site URL (used in sitemap, robots and schema markup)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console → URL-prefix property → HTML tag verification.
# Paste only the content value, not the full <meta> tag. This is server-side
# configuration; it is intentionally not a NEXT_PUBLIC browser variable.
GOOGLE_SITE_VERIFICATION=

# Cloudinary image uploads in the admin panel (optional — without these the
# panel falls back to plain URL inputs).
# Setup: cloudinary.com → free account → Settings → Upload → add an UNSIGNED
# upload preset (restrict it to one folder, e.g. "krush"). No API secret needed.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---- Maintenance mode (proxy.ts) ----
# Set MAINTENANCE_MODE=1 to take the whole site down behind a branded 503
# holding page. Leave unset/anything-else for a normal live site.
# MAINTENANCE_BYPASS_SECRET is your way back in while it's on: visit
# https://<site>/?preview=<secret> once and a cookie lets you browse the real
# site (storefront + /admin) as normal. Use a long random string, and rotate it
# by changing the value (old cookies stop matching immediately).
MAINTENANCE_MODE=
MAINTENANCE_BYPASS_SECRET=
