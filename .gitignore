# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/docs
.claude

# backend (Django) — code IS tracked; local-only artifacts are not.
# backend/.env is already covered by the .env* rule below.
backend/.venv/
backend/db.sqlite3
backend/staticfiles/
__pycache__/
*.pyc
# the Dockerfile deploy path is broken (hangs after migrate — caused an
# outage); Railway must keep building with NIXPACKS via backend/railway.json
backend/Dockerfile

# next.js
/.next/
/out/

# production
/build
/docs


# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# internal business documents — never ship to client or public repo
docs/PROJECT_PROPOSAL.md

# playwright
/test-results/
/playwright-report/
