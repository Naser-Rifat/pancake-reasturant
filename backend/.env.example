# ============================================================
# The Pancake Club — backend environment variables
# Copy the PRODUCTION block into Railway → your service → Variables.
# Local dev needs none of these except DJANGO_DEBUG=1.
# ============================================================

# ---------- required in production ----------
DJANGO_DEBUG=0
# long random string — generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Railway Postgres injects this automatically when the database service is linked.
DATABASE_URL=
DJANGO_ALLOWED_HOSTS=your-backend.up.railway.app
DJANGO_CORS_ORIGINS=https://www.thepancakeclub.com.au,https://thepancakeclub.com.au
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.thepancakeclub.com.au,https://thepancakeclub.com.au
DJANGO_FRONTEND_URL=https://www.thepancakeclub.com.au

# ---------- email delivery (required for order/booking emails) ----------
# Recommended on Railway: Brevo's HTTPS API works on every plan. Use a Brevo
# v3 API key, not an SMTP key. Selecting the provider explicitly prevents a
# staging/test environment from sending real email just because it has a key.
DJANGO_EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# seconds before a slow email provider is abandoned (requests never hang on it)
DJANGO_EMAIL_TIMEOUT=10
# Retry once only when the provider definitively returns HTTP 429/5xx (1–3).
DJANGO_EMAIL_SEND_ATTEMPTS=2
# what customers see in the From line — use a real address on the same domain
# as the verified Brevo sender
DJANGO_FROM_EMAIL=The Pancake Club <hello@thepancakeclub.com.au>

# Optional SMTP fallback for hosts that allow outbound SMTP. Leave unset when
# using the Brevo provider (Railway Free/Trial/Hobby blocks SMTP).
# DJANGO_EMAIL_PROVIDER=smtp
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=
# DJANGO_EMAIL_PASSWORD=
# DJANGO_EMAIL_TLS=1

# ---------- optional Stripe payments (currently disabled; orders pay at counter) ----------
# Leave these unset while the direct pay-at-counter flow is active. If Stripe
# is re-enabled in code, use live keys only after completing webhook tests.
# STRIPE_SECRET_KEY=
# From Stripe dashboard → Developers → Webhooks after registering
#   https://<railway-domain>/api/webhooks/stripe/
# (locally: from `stripe listen --print-secret`)
# STRIPE_WEBHOOK_SECRET=

# ---------- local development only ----------
# DJANGO_DEBUG=1
# (leave the email vars unset locally — emails print to the runserver console)
# (backend/.env is read automatically in dev; real env vars always win)
